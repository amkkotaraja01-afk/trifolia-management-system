# Local development example. Never commit real secrets.
NODE_ENV=development
PORT=3001
STORAGE_MODE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trifolia_app
DB_PASSWORD=CHANGE_ME
DB_NAME=trifolia_management
DB_CREATE_DATABASE=false
DB_POOL_SIZE=5
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Used only to create the first management account when app_state has no row.
# Use a unique account name and a random password of at least 16 characters.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
