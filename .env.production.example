# Set these in your hosting provider's environment settings.
NODE_ENV=production
PORT=10000
TRUST_PROXY=1
STORAGE_MODE=mysql
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_USER=trifolia_app
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DB_NAME=trifolia_management
DB_CREATE_DATABASE=false
DB_POOL_SIZE=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional absolute path to a CA certificate if your provider requires one
# DB_SSL_CA_FILE=/app/certs/ca.pem

# Used only to create the first management account when app_state has no row.
# Use a unique account name and a random password of at least 16 characters.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
